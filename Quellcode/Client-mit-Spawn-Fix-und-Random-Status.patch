+fn fire_random_status() -> Option<Cow<'static, str>> {
+    // Direct SpEffects need resist-point deltas. Attack-power fields are consumed on hit.
+    const EFFECT_ID: i32 = 20_012_083;
+    const BUILDUP: i32 = 10_000;
+
+    let wcm = unsafe { WorldChrMan::instance_mut() }.ok()?;
+    let player = wcm.main_player.as_mut()?;
+    if er_logic::death_guard::lists_unsafe_to_touch(player.chr_ins.modules.data.hp) {
+        return None;
+    }
+
+    let repo = unsafe { SoloParamRepository::instance_mut() }.ok()?;
+    let row =
+        crate::param_guard::get_mut::<SpEffectParam>(repo, EFFECT_ID as u32, "trap random_status")?;
+    let statuses = [
+        (
+            "Poison",
+            SpEffectParamRow::set_change_poison_resist_point as fn(&mut SpEffectParamRow, i32),
+        ),
+        (
+            "Scarlet Rot",
+            SpEffectParamRow::set_change_disease_resist_point,
+        ),
+        (
+            "Blood Loss",
+            SpEffectParamRow::set_change_blood_resist_point,
+        ),
+        (
+            "Frostbite",
+            SpEffectParamRow::set_change_freeze_resist_point,
+        ),
+        ("Sleep", SpEffectParamRow::set_change_sleep_resist_point),
+        ("Madness", SpEffectParamRow::set_change_madness_resist_point),
+        (
+            "Death Blight",
+            SpEffectParamRow::set_change_curse_resist_point,
+        ),
+    ];
+    let (name, set_buildup) = statuses[rand::random_range(0..statuses.len())];
+    for (_, reset_buildup) in statuses {
+        reset_buildup(row, 0);
+    }
+    // Let the effect survive a game update, with no periodic pulse before it expires.
+    row.set_effect_endurance(0.25);
+    row.set_motion_interval(1.0);
+    set_buildup(row, BUILDUP);
+    if player
+        .chr_ins
+        .special_effect
+        .entries()
+        .any(|e| e.param_id == EFFECT_ID)
+    {
+        player.chr_ins.remove_speffect(EFFECT_ID);
+    }
+    player.chr_ins.apply_speffect(EFFECT_ID, false);
+    if !player
+        .chr_ins
+        .special_effect
+        .entries()
+        .any(|e| e.param_id == EFFECT_ID)
+    {
+        log::warn!("trap random_status: game rejected SpEffect {EFFECT_ID} ({name})");
+        return None;
+    }
+    log::info!("trap random_status: activated SpEffect {EFFECT_ID} for {name}");
+    Some(Cow::Owned(format!("TRAP: Random Status -- {name}")))
+}
